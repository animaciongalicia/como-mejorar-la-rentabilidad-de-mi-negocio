# ──────────────────────────────────────────────
# focorentabilismo.com — Variables de entorno
# Copia este fichero como .env.local para desarrollo
# ──────────────────────────────────────────────

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX          # ID de Google Analytics 4

# Publicidad (false = ocultar zonas de anuncios)
NEXT_PUBLIC_ADS_ENABLED=false

# Webhooks
WEBHOOK_SECRET=cambia-esto-por-un-secreto-real

# Email / CRM (Brevo)
BREVO_API_KEY=                         # API key de Brevo (antes Sendinblue)
BREVO_LIST_ID=                         # ID de la lista de contactos en Brevo

# Make.com
MAKE_WEBHOOK_SUBSCRIBE_URL=            # URL del webhook de suscripción en Make.com
MAKE_WEBHOOK_CONTENT_URL=              # URL del webhook de distribución de contenido

# Supabase (opcional — para leads y analytics avanzado)
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
