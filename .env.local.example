# ── Brevo (newsletter) ──────────────────────────────────────────────────────
# Get at: https://app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# List ID: Brevo → Contacts → Lists → click your list → the number in the URL
BREVO_LIST_ID=1

# Sender identity (must be verified in Brevo)
BREVO_SENDER_EMAIL=hola@focorentabilismo.com
BREVO_SENDER_NAME=Foco Rentabilismo

# ── Weekly digest security ──────────────────────────────────────────────────
# Any random string — used as Bearer token when triggering /api/send-digest
# Generate one: openssl rand -hex 32
DIGEST_SECRET=change-me-to-a-random-string

# ── Make.com webhook (optional) ────────────────────────────────────────────
# If you also want Make.com to receive subscriber events
# MAKE_WEBHOOK_SUBSCRIBE_URL=https://hook.eu1.make.com/XXXXXXXXXXXXXXXX
NEXT_PUBLIC_GA_ID=G-DQG4DWTXKL
